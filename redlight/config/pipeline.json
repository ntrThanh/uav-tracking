{
  "detector": {
    "weights": "weights/yolo11n.pt",
    "imgsz": 640,
    "conf": 0.25,
    "iou": 0.5,
    "agnostic_nms": true,
    "device": "auto",
    "half": false,
    "classes": {"2": "car", "3": "motorcycle", "5": "bus", "7": "truck"}
  },
  "tracker": {
    "track_high_thresh": 0.25,
    "track_low_thresh": 0.1,
    "new_track_thresh": 0.25,
    "track_buffer": 30,
    "match_thresh": 0.8,
    "fuse_score": true,
    "history_len": 150
  },
  "video": {"start_s": 0.0, "end_s": null, "stride": 1},
  "output": {"write_video": true, "codec": "mp4v", "trail_len": 30, "log_every": 50}
}
